{
    "rules": {
        ".read": false,
        ".write": false,

        // Persons
        "persons": {
            ".read": true,
            ".write": false,
            "$id": {
                ".validate": "$id.matches(/^[0-9]{4}[A-Z]{4}[0-9]{2}$/)",
                "name": {
                    ".validate": "newData.isString()"
                },
                "$other": {
                    ".validate": false
                }
            }
        },

        "$other": {
            ".validate": false
        }
    }
}
